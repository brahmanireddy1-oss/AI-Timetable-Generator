# BusMate AI - Environment Configuration

# LiveKit Cloud or Self-Hosted Server
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API (Multimodal Live / Realtime Voice)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_VOICE=Puck

# LiveKit SIP & Telephony Configuration
SIP_PHONE_NUMBER=+91-40-MOCKBUS
SIP_TRUNK_ID=ST_mock_tgsrtc_inbound
SIP_DISPATCH_RULE_ID=DR_mock_dispatch

# Server Settings
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true
